# BountyHub frontend env (copy to .env.local — see README for Cloudflare Pages)
#
# GIPHY: create a key at https://developers.giphy.com/ (SDK / API key works with v1 REST).
# Required for Team Hub sidebar GIF search. Also set VITE_GIPHY_API_KEY in Cloudflare Pages.

VITE_API_URL=http://localhost:8788
VITE_GIPHY_API_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_SOLANA_RPC_URL=
# Optional browser error reporting (omit to disable)
VITE_SENTRY_DSN=

# --- Worker secrets (set via `wrangler secret put`, not in frontend .env) ---
# See .dev.vars.example for local Worker secrets.
# Production: SESSION_SECRET, SOLANA_*, CLOUDINARY_API_*, HTML2PDF_API_KEY,
# CRON_SECRET, TOKEN_ENCRYPTION_KEY, GITHUB_CLIENT_*, GITHUB_PAT
#
# Generate TOKEN_ENCRYPTION_KEY: openssl rand -base64 32
# Generate CRON_SECRET: openssl rand -base64 48


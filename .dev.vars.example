# Local development secrets for `wrangler.dev.toml` (copy to .dev.vars — never commit).
# Wrangler loads .dev.vars automatically in `wrangler dev`.

SESSION_SECRET=dev-secret-key-change-me
SOLANA_RPC_URL=https://api.devnet.solana.com
# Phantom-style base58 secret key (64-byte) or legacy base64
SOLANA_WALLET_PRIVATE_KEY=dev-key
SOLANA_WALLET_ADDRESS=dev-address
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
HTML2PDF_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CRON_SECRET=dev-cron-secret
# 32 random bytes, base64 — e.g. openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
GITHUB_PAT=
# Gravity publisher API key (Settings → Platform Settings). Never commit the real value.
GRAVITY_API_KEY=
# Set to true only when ready for live ads (billing). Default/local: test creatives.
GRAVITY_PRODUCTION=false
